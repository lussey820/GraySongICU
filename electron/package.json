{
  "name": "graysongicu",
  "version": "1.0.0",
  "private": true,
  "description": "GraySongICU 桌面版：本机服务 + 主窗口 + 桌面歌词",
  "author": "GraySongICU",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win dir zip nsis",
    "dist:nsis": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.graysongicu.app",
    "productName": "GraySongICU",
    "copyright": "GraySongICU",
    "asar": true,
    "npmRebuild": false,
    "compression": "normal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server.js",
        "to": "server.js"
      },
      {
        "from": "icon.png",
        "to": "icon.png"
      },
      {
        "from": "../bin/ffmpeg.exe",
        "to": "bin/ffmpeg.exe"
      }
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "include": "installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GraySongICU",
      "uninstallDisplayName": "GraySongICU",
      "deleteAppDataOnUninstall": false,
      "artifactName": "GraySongICU-Setup-${version}.${ext}"
    }
  }
}
